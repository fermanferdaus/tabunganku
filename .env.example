# Application Environment
APP_ENV=local
FLASK_DEBUG=true
PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key-32chars-min!
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Database Configuration
# Gunakan '127.0.0.1' untuk lokal native, atau 'mysql' jika menggunakan Docker Compose
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=root_secure_password_123
DB_USER=root
DB_PASSWORD=
DB_NAME=db_tabungan
DB_SSL=false

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-32bytes-min!
JWT_EXPIRY_HOURS=24
